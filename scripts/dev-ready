#!/usr/bin/env bash
set -euo pipefail
attempts=1
if [ "${1:-}" = --wait ]; then attempts=60; fi
for (( i=0; i<attempts; i++ )); do
  if curl -fsS "http://127.0.0.1:${BACKEND_PORT:-4000}/health" >/dev/null && curl -fsS "http://127.0.0.1:${VITE_PORT:-5173}" >/dev/null; then exit 0; fi
  sleep 1
done
echo 'Development services are not ready' >&2
exit 1
