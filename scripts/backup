#!/usr/bin/env python3
"""Offline database-and-attachment backup. See docs/operations.md."""
import datetime
import json
import os
from pathlib import Path
import shutil
import subprocess
import sys
import tarfile
import tempfile
from urllib.parse import parse_qs, unquote, urlparse


def postgres_environment():
    raw = os.environ.get("DATABASE_URL", "")
    url = urlparse(raw)
    if url.scheme not in ("postgres", "postgresql") or not url.path.strip("/"):
        raise SystemExit("DATABASE_URL must be a PostgreSQL URL")
    env = dict(os.environ)
    for key, value in {
        "PGHOST": url.hostname or "localhost", "PGPORT": str(url.port or 5432),
        "PGUSER": unquote(url.username or "postgres"),
        "PGPASSWORD": unquote(url.password or ""), "PGDATABASE": unquote(url.path[1:]),
    }.items():
        env[key] = value
    allowed = {"sslmode": "PGSSLMODE", "sslrootcert": "PGSSLROOTCERT", "sslcert": "PGSSLCERT",
               "sslkey": "PGSSLKEY", "connect_timeout": "PGCONNECT_TIMEOUT", "options": "PGOPTIONS"}
    for key, values in parse_qs(url.query).items():
        if key not in allowed:
            raise SystemExit(f"Unsupported backup connection option: {key}")
        env[allowed[key]] = values[-1]
    return env


def main():
    if len(sys.argv) != 2:
        raise SystemExit("usage: scripts/backup /absolute/path/moneybags.tar.gz")
    if os.environ.get("MONEYBAGS_WRITES_STOPPED") != "1":
        raise SystemExit("Stop ALL application processes and cleanup jobs, then set MONEYBAGS_WRITES_STOPPED=1")
    destination = Path(sys.argv[1]).resolve()
    if destination.exists():
        raise SystemExit("Backup destination already exists")
    backend = os.environ.get("DATABASE_BACKEND", "postgresql")
    if backend not in ("jed", "postgresql"):
        raise SystemExit("DATABASE_BACKEND must be jed or postgresql")
    attachments = Path(os.environ.get("ATTACHMENTS_DIR", "data/attachments")).resolve()
    if not attachments.is_dir():
        raise SystemExit("ATTACHMENTS_DIR must exist")
    destination.parent.mkdir(parents=True, exist_ok=True)
    with tempfile.TemporaryDirectory(prefix="moneybags-backup-") as directory:
        root = Path(directory)
        manifest = {"format": 1, "backend": backend, "created_at": datetime.datetime.now(datetime.timezone.utc).isoformat()}
        (root / "manifest.json").write_text(json.dumps(manifest) + "\n")
        shutil.copytree(attachments, root / "attachments")
        if backend == "jed":
            database = Path(os.environ.get("JED_DATA_DIR", "data/jed")).resolve()
            if not (database / "global.jed").is_file():
                raise SystemExit("JED_DATA_DIR does not contain global.jed")
            shutil.copytree(database, root / "jed")
        else:
            subprocess.run(["pg_dump", "--format=custom", "--no-owner", "--file", str(root / "database.dump")],
                           env=postgres_environment(), check=True)
        fd, temporary = tempfile.mkstemp(prefix=".moneybags-backup-", dir=destination.parent)
        try:
            os.close(fd)
            with tarfile.open(temporary, "w:gz") as archive:
                for item in root.iterdir():
                    archive.add(item, arcname=item.name)
            # Refuse replacement even if another backup appeared during copying.
            os.link(temporary, destination)
        finally:
            os.unlink(temporary)
    print(destination)


if __name__ == "__main__":
    main()
