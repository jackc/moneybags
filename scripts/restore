#!/usr/bin/env python3
"""Restore a trusted backup into empty destinations while all writers are stopped."""
import runpy
import json
import os
from pathlib import Path, PurePosixPath
import shutil
import subprocess
import sys
import tarfile
import tempfile


def empty_destination(path):
    if path.exists() and (not path.is_dir() or any(path.iterdir())):
        raise SystemExit(f"Restore destination must be empty: {path}")


def main():
    if len(sys.argv) != 2:
        raise SystemExit("usage: scripts/restore /absolute/path/moneybags.tar.gz")
    if os.environ.get("MONEYBAGS_WRITES_STOPPED") != "1":
        raise SystemExit("Stop ALL application processes and cleanup jobs, then set MONEYBAGS_WRITES_STOPPED=1")
    attachments = Path(os.environ.get("ATTACHMENTS_DIR", "data/attachments")).resolve()
    empty_destination(attachments)
    with tempfile.TemporaryDirectory(prefix="moneybags-restore-") as directory:
        root = Path(directory)
        with tarfile.open(sys.argv[1], "r:gz") as archive:
            for member in archive.getmembers():
                path = PurePosixPath(member.name)
                if path.is_absolute() or ".." in path.parts or not (member.isfile() or member.isdir()):
                    raise SystemExit("Backup contains an unsafe path or link")
                if not path.parts or path.parts[0] not in {"manifest.json", "attachments", "jed", "database.dump"}:
                    raise SystemExit("Unrecognized backup content")
            archive.extractall(root, filter="data")
        manifest = json.loads((root / "manifest.json").read_text())
        backend = os.environ.get("DATABASE_BACKEND", "postgresql")
        if manifest.get("format") != 1 or manifest.get("backend") != backend:
            raise SystemExit("Backup format or selected database backend does not match")
        if not (root / "attachments").is_dir():
            raise SystemExit("Backup has no attachment directory")
        if backend == "jed":
            database = Path(os.environ.get("JED_DATA_DIR", "data/jed")).resolve()
            empty_destination(database)
            if not (root / "jed/global.jed").is_file():
                raise SystemExit("Backup has no Jed database")
            shutil.copytree(root / "jed", database, dirs_exist_ok=True)
        elif backend == "postgresql":
            helper = runpy.run_path(str(Path(__file__).with_name("backup")))
            env = helper["postgres_environment"]()
            count = subprocess.check_output(["psql", "--no-psqlrc", "-Atc", "SELECT count(*) FROM pg_tables WHERE schemaname='public'"], env=env, text=True).strip()
            if count != "0":
                raise SystemExit("PostgreSQL restore target must be an empty database")
            subprocess.run(["pg_restore", "--single-transaction", "--exit-on-error", "--no-owner", "--dbname", env["PGDATABASE"], str(root / "database.dump")], env=env, check=True)
        else:
            raise SystemExit("DATABASE_BACKEND must be jed or postgresql")
        shutil.copytree(root / "attachments", attachments, dirs_exist_ok=True)
    print("Restored database and attachments. Verify the application before reopening access.")


if __name__ == "__main__":
    main()
